{
  "name": "soramimic-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-static-assets.mjs",
    "preview": "vite preview",
    "test:smoke": "npm run build && node tests/logo.mjs && node tests/smoke.mjs",
    "test:editor": "npm run build && node tests/editor-smoke.mjs",
    "test:touch": "npm run build && node tests/editor-touch.mjs",
    "test:assets": "npm run build && node tests/static-assets.mjs",
    "sync-dict": "node -e \"const fs=require('fs');fs.cpSync('node_modules/kuromoji/dict','public/kuromoji/dict',{recursive:true});for(const f of ['LICENSE-2.0.txt','NOTICE.md'])fs.copyFileSync('node_modules/kuromoji/'+f,'public/kuromoji/'+f)\"",
    "predev": "npm run sync-dict",
    "prebuild": "npm run sync-dict"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "kuromoji": "^0.1.2"
  }
}
